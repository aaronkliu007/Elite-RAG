# Development-only credentials. Replace every value outside local development.
POSTGRES_DB=rag_local
RAG_DB_MIGRATION_USER=rag_migrator
RAG_DB_MIGRATION_PASSWORD=local_migration_password
RAG_DB_RUNTIME_USER=rag_runtime
RAG_DB_RUNTIME_PASSWORD=local_runtime_password
MINIO_ROOT_USER=local_minio_admin
MINIO_ROOT_PASSWORD=local_minio_password
RAG_MINIO_ACCESS_KEY=local_rag_app
RAG_MINIO_SECRET_KEY=local_app_secret_password
RAG_MINIO_BUCKET=rag-documents
# Supply your own AIStor Free license outside this repository; never commit the file.
RAG_MINIO_LICENSE_FILE=E:/git_secrets/Elite-RAG/minio.license
RAG_OPENSEARCH_ENABLED=true
RAG_OPENSEARCH_ENDPOINT=http://127.0.0.1:9200
RAG_OPENSEARCH_CONNECT_TIMEOUT=PT3S
RAG_OPENSEARCH_RESPONSE_TIMEOUT=PT10S
RAG_VECTOR_ENABLED=false
RAG_VECTOR_DIMENSION=1536
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

# Core API model gateway settings. Pass these to the native Spring Boot process;
# the infrastructure-only Compose stack intentionally does not receive model credentials.
RAG_AI_ENABLED=false
RAG_AI_PROVIDER=
RAG_AI_CONFIG_VERSION=
RAG_AI_ENDPOINT=
RAG_AI_APPROVED_HOSTS=
RAG_AI_API_KEY=
RAG_AI_EMBEDDING_MODEL=
RAG_AI_RERANKER_MODEL=
RAG_AI_CHAT_MODEL=
RAG_QA_QUESTION_HMAC_KEY=
RAG_QA_ACTOR_RATE_LIMIT_WINDOW=PT1M
RAG_QA_ACTOR_RATE_LIMIT_MAX_REQUESTS=20
# Local-only fictional golden-dataset fixture; keep false outside an isolated evaluation database.
RAG_QA_EVALUATION_FIXTURE_ENABLED=false
RAG_AI_CONNECT_TIMEOUT=PT3S
RAG_AI_RESPONSE_TIMEOUT=PT15S
RAG_AI_TOTAL_TIMEOUT=PT30S
RAG_AI_MAX_INPUT_TOKENS=12000
RAG_AI_MAX_OUTPUT_TOKENS=2000
RAG_AI_MAX_CONCURRENCY=4
RAG_AI_DAILY_DEPLOYMENT_TOKEN_LIMIT=1000000
RAG_AI_INPUT_COST_PER_MILLION_TOKENS=0
RAG_AI_OUTPUT_COST_PER_MILLION_TOKENS=0
