# Development-only credentials. Replace every value outside local development.
POSTGRES_DB=rag_local
RAG_DB_MIGRATION_USER=rag_migrator
RAG_DB_MIGRATION_PASSWORD=local_migration_password
RAG_DB_RUNTIME_USER=rag_runtime
RAG_DB_RUNTIME_PASSWORD=local_runtime_password
MINIO_ROOT_USER=local_minio_admin
MINIO_ROOT_PASSWORD=local_minio_password
RAG_MINIO_ACCESS_KEY=local_rag_app
RAG_MINIO_SECRET_KEY=local_app_secret_password
RAG_MINIO_BUCKET=rag-documents
# Supply your own AIStor Free license outside this repository; never commit the file.
RAG_MINIO_LICENSE_FILE=E:/git_secrets/Elite-RAG/minio.license
