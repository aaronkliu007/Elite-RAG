{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yunjihai:rag:canonical-document-v1",
  "title": "云基华海统一文档 v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "jobId", "status", "document", "errors"],
  "properties": {
    "schemaVersion": { "const": "canonical-document-v1" },
    "jobId": { "type": "string", "format": "uuid" },
    "status": { "enum": ["SUCCEEDED", "FAILED"] },
    "document": { "oneOf": [{ "$ref": "#/$defs/document" }, { "type": "null" }] },
    "errors": { "type": "array", "items": { "$ref": "#/$defs/error" }, "maxItems": 20 }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "SUCCEEDED" } } },
      "then": {
        "properties": {
          "document": { "$ref": "#/$defs/document" },
          "errors": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "FAILED" } } },
      "then": {
        "properties": {
          "document": { "type": "null" },
          "errors": { "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceFilename", "mediaType", "pageCount", "nodes"],
      "properties": {
        "sourceFilename": { "type": "string", "minLength": 1, "maxLength": 255 },
        "mediaType": { "type": "string", "minLength": 1, "maxLength": 255 },
        "pageCount": { "type": "integer", "minimum": 1 },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" }, "maxItems": 1000000 }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "kind", "text", "parentNodeId", "page", "bbox", "tableCells", "confidence"],
      "properties": {
        "nodeId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "kind": { "enum": ["TITLE", "HEADING", "PARAGRAPH", "LIST_ITEM", "TABLE", "IMAGE", "CAPTION", "PAGE_BREAK"] },
        "text": { "type": "string" },
        "parentNodeId": { "type": ["string", "null"], "maxLength": 128 },
        "page": { "type": ["integer", "null"], "minimum": 1 },
        "bbox": { "oneOf": [{ "$ref": "#/$defs/bbox" }, { "type": "null" }] },
        "tableCells": {
          "oneOf": [
            { "type": "array", "items": { "$ref": "#/$defs/tableCell" }, "maxItems": 100000 },
            { "type": "null" }
          ]
        },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 }
      }
    },
    "tableCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row", "column", "rowSpan", "columnSpan", "text"],
      "properties": {
        "row": { "type": "integer", "minimum": 0 },
        "column": { "type": "integer", "minimum": 0 },
        "rowSpan": { "type": "integer", "minimum": 1 },
        "columnSpan": { "type": "integer", "minimum": 1 },
        "text": { "type": "string" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "enum": ["UNSUPPORTED", "ENCRYPTED", "LIMIT_EXCEEDED", "CONVERSION_FAILED", "TIMEOUT"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 },
        "retryable": { "type": "boolean" }
      }
    }
  }
}
